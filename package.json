{
  "name": "spotglass-webhost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SpotGlass — Spotify-inspired Yandex Music interface for PulseSync WebHost",
  "scripts": {
    "dev": "node ./scripts/dev-build.mjs",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:modules": "node ./scripts/module-compile.mjs",
    "format": "oxfmt .",
    "sync": "node ./scripts/sync-addon.mjs",
    "build:sync": "npm run build && npm run sync",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@pulsesync/addon-sdk": "0.18.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.75.0",
    "react": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
